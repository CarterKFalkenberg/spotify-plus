{
  "name": "spotify-plus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "vite build",
    "format:check": "prettier --check app proxy tests/proxy tests/browser tests/tooling vite.config.ts vitest.config.ts playwright.config.ts tsconfig.json package.json scripts/check-supabase.mjs scripts/import-bootstrap.mjs scripts/prepare-deployment.mjs scripts/verify-stage.mjs scripts/live/config.mjs",
    "check": "sh scripts/check"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
