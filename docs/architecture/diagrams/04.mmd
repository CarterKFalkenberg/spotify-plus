erDiagram
 annotations ||--o| track_metadata : caches
 annotations ||--o{ track_tags : has
 tags ||--o{ track_tags : assigned
 tags ||--o{ tag_actions : changed_by
 tag_actions ||--o{ tag_action_edges : records
 annotations ||--o{ tag_action_edges : affected
